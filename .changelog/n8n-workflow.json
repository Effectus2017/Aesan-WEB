{
  "name": "Local Git Changelog Generator",
  "nodes": [
    {
      "parameters": {
        "cronExpression": "*/5 * * * *",
        "executeOnce": false,
        "timezone": "America/New_York"
      },
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "position": [100, 300]
    },
    {
      "parameters": {
        "command": "cd /Volumes/Mac/Proyectos/AESAN/Proyecto/Web && git log -1 --format='%H'",
        "executeInLine": true,
        "timeout": 30000,
        "workingDirectory": "/Volumes/Mac/Proyectos/AESAN/Proyecto/Web"
      },
      "name": "Check Latest Commit",
      "type": "n8n-nodes-base.executeCommand",
      "position": [300, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$node[\"Check Latest Commit\"].json[\"stdout\"]}}",
              "value2": "={{$workflow.variables(\"lastCommitHash\")}}"
            }
          ]
        }
      },
      "name": "Commit Change Detector",
      "type": "n8n-nodes-base.if",
      "position": [500, 300]
    },
    {
      "parameters": {
        "projectPath": "/Volumes/Mac/Proyectos/AESAN/Proyecto/Web",
        "changelogPaths": {
          "main": "/.changelog/web-changelog.md",
          "history": "/.changelog/history/",
          "human": "/.changelog/human/"
        },
        "jsCode": "const commits = items[0].json.commits || [];\nconst dateRange = getDateRange(commits);\n\nfunction getDateRange(commits) {\n  if (commits.length === 0) {\n    return { start: null, end: null };\n  }\n  return {\n    start: commits[0].timestamp,\n    end: commits[commits.length - 1].timestamp\n  };\n}\n\nreturn [\n  {\n    json: {\n      commits,\n      dateRange,\n      projectType: 'web'\n    }\n  }\n];"
      },
      "name": "Process Commits",
      "type": "n8n-nodes-base.code",
      "position": [700, 300]
    },
    {
      "parameters": {
        "filePath": "/Volumes/Mac/Proyectos/AESAN/Proyecto/Web/.changelog/web-changelog.md",
        "fileContent": "={{$node[\"Format Content\"].json.changelogContent}}",
        "binaryProperty": "data",
        "fileName": "web-changelog.md",
        "fileType": "string"
      },
      "name": "Write Changelog Main",
      "type": "n8n-nodes-base.writeBinaryFile",
      "position": [900, 250]
    },
    {
      "parameters": {
        "filePath": "=/Volumes/Mac/Proyectos/AESAN/Proyecto/Web/.changelog/history/web-{{$node[\"Process Commits\"].json.dateRange.end}}.md",
        "fileContent": "={{$node[\"Format Content\"].json.historyContent}}",
        "binaryProperty": "data",
        "fileName": "={{'web-' + $node[\"Process Commits\"].json.dateRange.end + '.md'}}",
        "fileType": "string"
      },
      "name": "Write Changelog History",
      "type": "n8n-nodes-base.writeBinaryFile",
      "position": [900, 300]
    },
    {
      "parameters": {
        "filePath": "=/Volumes/Mac/Proyectos/AESAN/Proyecto/Web/.changelog/human/web-{{$node[\"Process Commits\"].json.dateRange.end}}.md",
        "fileContent": "={{$node[\"Format Content\"].json.humanContent}}",
        "binaryProperty": "data",
        "fileName": "={{'web-' + $node[\"Process Commits\"].json.dateRange.end + '.md'}}",
        "fileType": "string"
      },
      "name": "Write Changelog Human",
      "type": "n8n-nodes-base.writeBinaryFile",
      "position": [900, 350]
    },
    {
      "parameters": {
        "jsCode": "const { commits, dateRange } = items[0].json;\n\nfunction formatChangelog(commits) {\n  // Lógica para formatear el changelog\n}\n\nfunction formatHistory(commits) {\n  // Lógica para formatear el historial\n}\n\nfunction formatHuman(commits) {\n  // Lógica para formatear la descripción humana\n}\n\nreturn {json: {\n  changelogContent: formatChangelog(commits),\n  historyContent: formatHistory(commits),\n  humanContent: formatHuman(commits)\n}};"
      },
      "name": "Format Content",
      "type": "n8n-nodes-base.code",
      "position": [500, 300]
    },
    {
      "parameters": {
        "command": "cd /Volumes/Mac/Proyectos/AESAN/Proyecto/Web && git add .changelog/ && git commit -m \"docs: Update changelog files\" && git push origin HEAD",
        "executeInLine": true
      },
      "name": "Git Operations",
      "type": "n8n-nodes-base.executeCommand",
      "position": [900, 300]
    }
  ],
  "connections": {
    "Cron": {
      "main": [
        [
          {
            "node": "Check Latest Commit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Latest Commit": {
      "main": [
        [
          {
            "node": "Commit Change Detector",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Commit Change Detector": {
      "true": [
        [
          {
            "node": "Process Commits",
            "type": "main",
            "index": 0
          }
        ]
      ],
      "false": []
    },
    "Process Commits": {
      "main": [
        [
          {
            "node": "Write Changelog Main",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Write Changelog History",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Write Changelog Human",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write Changelog Files": {
      "main": [["Git Operations"]]
    }
  }
}
