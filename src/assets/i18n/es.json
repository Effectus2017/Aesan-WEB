            },
            "paf": {
                "title": "PAF",
                "questions": {
                    "who-can-sponsor": {
                        "title": "¿Quiénes pueden auspiciar del PAF?",
                        "answer": "Niños y Adultos participantes de los Programas de Alimentos que administra la Agencia Estatal, Servicios de Alimentos y Nutrición del Departamento de Educación."
                    },
                    "what-services": {
                        "title": "¿Qué servicios pueden ofrecer los Alimentos Federales a los auspiciadores?",
                        "answers": {
                            "0": "Pueden ofrecer los servicios de desayuno, almuerzo, merienda y cena si aplica."
                        }
                    }
                }
            },
            "pdfe": {
                "title": "PDFE",
                "questions": {
                    "what-is-farm-to-school": {
                        "title": "¿Qué es de la granja a la escuela?",
                        "answers": {
                            "0": "De la granja a la escuela enriquece la conexión que tienen las comunidades con alimentos frescos y saludables y con los productores locales de alimentos al mejorar la compra de alimentos y las prácticas educativas en las escuelas y los sitios de educación y cuidado infantil. De la granja a la escuela, que incluye la educación y el cuidado de la granja a la primera infancia, permite a los niños y a sus familias tomar decisiones alimentarias informadas, fortaleciendo al mismo tiempo la economía local y contribuyendo a comunidades vibrantes. La implementación de la granja a la escuela difiere según la ubicación, pero siempre incluye uno o más de los siguientes tres elementos centrales.",
                            "1": "Adquisición: Los alimentos locales se compran, promocionan y sirven en la cafetería o durante las comidas, como refrigerio o en degustaciones en el aula.",
                            "2": "Educación: Los estudiantes participan en actividades educativas relacionadas con la agricultura, la alimentación, la salud y la nutrición.",
                            "3": "Huertos escolares: los estudiantes participan en un aprendizaje práctico y experiencial a través de la jardinería."
                        }
                    }
                }
            },
            "psav": {
                "title": "PSAV",
                "questions": {
                    "summer-services": {
                        "title": "¿Cuántos servicios pueden ofrecer los auspiciadores durante el verano?",
                        "answers": {
                            "0": "Sitio abierto disponible para los niños de la comunidad pueden ofrecer hasta dos servicios diarios, (uno puede ser almuerzo; el otro puede ser desayuno, merienda o cena)",
                            "1": "Sitio cerrado, campamento o residencial pueden servir hasta tres (3) comidas diarias; desayuno, almuerzo, merienda o cena."
                        }
                    }
                }
            }
        }
