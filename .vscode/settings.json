{
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": false,
  },
  "spellright.language": [
    "es",
    "en"
  ],
  "spellright.documentTypes": [
    "markdown",
    "latex",
    "plaintext",
    "typescript"
  ],
  "appService.zipIgnorePattern": [
    "node_modules{,/**}",
    ".vscode{,/**}"
],
"appService.defaultWebAppToDeploy": "None",
"appService.deploySubpath": "dist/aesanweb/browser"
}
